# Contact form (src/app/contact/page.tsx) creates/updates a lead in
# SharpSpring via a secure server-side route (src/app/api/contact/route.ts).
# Find these in SharpSpring under Setup > Sales Automation > API. Keep both
# server-only (no NEXT_PUBLIC_ prefix) - the secret key must never reach the
# browser.
SHARPSPRING_ACCOUNT_ID=
SHARPSPRING_SECRET_KEY=

# Optional: numeric IDs of the SharpSpring lists each form's leads should be
# added to. Each source form sends its own formId (general_inquiry,
# ai_visibility_audit, gtm_growth_review, website_inquiry). Every lead's
# description also gets a "Source Form: ..." line so it stays identifiable
# even when several forms share one list.
#
# Only SHARPSPRING_CONTACT_FORM_LIST_ID is required - set it to the one
# shared list and every form falls back to it. Set any of the other three
# once a dedicated list exists for that form, and it takes over automatically
# with no code changes. Find an ID by opening the list in SharpSpring's List
# Manager and reading it from the page URL.
SHARPSPRING_CONTACT_FORM_LIST_ID=
SHARPSPRING_AI_VISIBILITY_LIST_ID=
SHARPSPRING_GTM_GROWTH_REVIEW_LIST_ID=
SHARPSPRING_WEBSITE_INQUIRY_LIST_ID=
