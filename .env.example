# Contact form (src/app/contact/page.tsx) submits via Web3Forms so it can
# email submissions without a backend. Get a free access key at
# https://web3forms.com (enter contact@brandiron.net, no account needed) and
# set it below in a local .env file (or your hosting provider's env settings).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Same contact form also creates/updates a lead in SharpSpring via a secure
# server-side route (src/app/api/contact/route.ts). Find these in
# SharpSpring under Setup > Sales Automation > API. Keep both server-only
# (no NEXT_PUBLIC_ prefix) - the secret key must never reach the browser.
SHARPSPRING_ACCOUNT_ID=
SHARPSPRING_SECRET_KEY=
